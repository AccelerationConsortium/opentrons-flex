{
  "sila_server": {
    "hostname": "0.0.0.0",
    "port": 50051,
    "tls": false,
    "require_client_auth": false,
    "uuid": "9f1d2b5a-7c3e-4a18-9b2c-1e7f5a3d8c42",
    "name": "Opentrons Flex Simulator"
  },
  "cloud_server_endpoint": null,
  "discovery": null,
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "simple": {
        "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
      }
    },
    "handlers": {
      "stderr": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stderr",
        "formatter": "simple"
      }
    },
    "root": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ]
    }
  },
  "use_simulator": true,
  "simulated_modules": [],
  "lock_timeout_s": 30.0,
  "labware_movement_config": null,
  "with_robot_server": false,
  "run_mutation_ledger_path": null,
  "run_mutation_required": false,
  "run_mutation_token_env": "UNITELABS_RUN_MUTATION_TOKEN",
  "run_mutation_actor_env": "UNITELABS_RUN_MUTATION_ACTOR"
}
